---
import Icon from './Icon.astro';
import { href, asset } from '../lib/paths.js';

/**
 * Featured work as two editorial plates: an index number, a large plate image,
 * the title set in serif, and the two actions that matter (read the note, open
 * the repository). Thumbnails fall back to the case illustration, then to the
 * neutral fold graphic — never to a bare letter block.
 */
const { projects } = Astro.props;
---

<div class="feature-list">
  {projects.map((project, index) => {
    const casePath = href(`cases/${encodeURIComponent(project.name)}/`);
    const thumb = project.coverAvailable
      ? asset(project.cover)
      : project.featured.poster?.asset
        ? asset(project.featured.poster.asset)
        : asset('assets/fold.svg');
    return (
      <article class="feature">
        <div class="feature-top">
          <span class="feature-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="feature-cat">{project.categoryLabel}</span>
        </div>

        <a class="feature-thumb" href={casePath} aria-label={`查看 ${project.featured.title} 详情`}>
          <img src={thumb} alt="" width="640" height="400" loading="lazy" />
        </a>

        <div class="feature-body">
          <h3>
            <a href={casePath}>{project.featured.title}</a>
          </h3>
          <p class="feature-desc">{project.description}</p>
          <div class="feature-actions">
            <a class="text-link" href={casePath}>
              项目笔记 <Icon name="arrow-right" size={12} />
            </a>
            {project.repo && (
              <a class="text-link" href={`${project.repo}#readme`} target="_blank" rel="noopener noreferrer">
                源码 <Icon name="arrow-up-right" size={12} />
              </a>
            )}
          </div>
        </div>
      </article>
    );
  })}
</div>
