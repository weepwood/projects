---
import Icon from './Icon.astro';
import { href } from '../lib/paths.js';

/**
 * Featured work as compact rows inside the dashboard: a thumbnail, one line of
 * copy and the two actions that actually matter (read the note, open the repo).
 */
const { projects } = Astro.props;
---

<div class="card">
  <div class="card-head">
    <h2>代表作品</h2>
    <span class="card-sub">长期维护、有明确使用场景</span>
    <div class="card-actions">
      <a class="btn btn--ghost btn--sm" href={href('catalog/')}>
        全部项目 <Icon name="arrow-right" size={13} />
      </a>
    </div>
  </div>

  <div class="feature-list">
    {projects.map((project) => {
      const casePath = href(`cases/${encodeURIComponent(project.name)}/`);
      const thumb = project.coverAvailable
        ? `/${project.cover}`
        : `/${project.featured.poster?.asset ?? 'assets/fold.svg'}`;
      return (
        <article class="feature">
          <a class="feature-thumb" href={casePath} aria-label={`查看 ${project.featured.title} 详情`}>
            <img src={thumb} alt="" width="132" height="78" loading="lazy" />
          </a>
          <div class="feature-main">
            <h3>
              <a href={casePath}>{project.featured.title}</a>
            </h3>
            <p>{project.description}</p>
          </div>
          <div class="feature-aside">
            <span class="pill pill--muted">{project.categoryLabel}</span>
            <a class="btn btn--sm" href={casePath}>
              项目笔记
            </a>
            {project.repo && (
              <a
                class="icon-btn"
                href={`${project.repo}#readme`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`打开 ${project.featured.title} 仓库`}
              >
                <Icon name="arrow-up-right" size={15} />
              </a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</div>
