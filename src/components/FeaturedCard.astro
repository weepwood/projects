---
import Poster from './Poster.astro';
import Icon from './Icon.astro';
import { href } from '../lib/paths.js';

const { project } = Astro.props;
const featured = project.featured;
const casePath = href(`cases/${encodeURIComponent(project.name)}/`);
---

<article class="feature">
  <Poster poster={featured.poster} name={featured.title} order={featured.order} href={casePath} />
  <div class="feature-body">
    <span class="eyebrow">{project.categoryLabel}</span>
    <h3>
      <a href={casePath}>{featured.title}</a>
    </h3>
    <p>{project.description}</p>
    <div class="actions">
      <a class="btn" href={casePath}>
        阅读项目笔记 <Icon name="arrow-right" size={14} />
      </a>
      {project.repo && (
        <a class="text-link" href={`${project.repo}#readme`} target="_blank" rel="noopener noreferrer">
          {featured.action} <Icon name="arrow-up-right" size={13} />
        </a>
      )}
    </div>
  </div>
</article>
