---
import Icon from './Icon.astro';

/**
 * Featured-work artwork, driven by content (`poster.kind` + `poster.tone`)
 * instead of by branching on the project name.
 */
const { poster, name, order, href } = Astro.props;
const kind = poster?.kind ?? 'type';
const tone = poster?.tone ?? 'paper';
const caption = poster?.caption ?? name;
const glyph = name.slice(0, 1).toUpperCase();
const toneClass = tone === 'paper' ? 'poster--plain' : `poster--${tone}`;
---

<a class={`poster poster--${kind} ${toneClass}`} href={href} aria-label={`查看 ${name} 详情`}>
  <span class="caption" aria-hidden="true">
    <span>PROJECT / {String(order).padStart(2, '0')}</span>
    <span>{caption}</span>
  </span>

  {kind === 'browser' && (
    <span class="mock" aria-hidden="true">
      <span class="mock-bar">
        <i />
        <i />
        <i />
      </span>
      <span class="mock-title">
        {caption}
        <span>.</span>
      </span>
      <span class="mock-row">
        <span>Research tabs</span>
        <span>12</span>
      </span>
      <span class="mock-row">
        <span>Saved sessions</span>
        <span>4</span>
      </span>
    </span>
  )}

  {kind === 'lens' && (
    <span class="lens" aria-hidden="true">
      <Icon name="aperture" size={44} />
    </span>
  )}

  {kind === 'type' && (
    <span class="glyph" aria-hidden="true">
      {glyph}
      <span>.</span>
    </span>
  )}
</a>
