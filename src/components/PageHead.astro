---
import Icon from './Icon.astro';
import { href } from '../lib/paths.js';

/**
 * Page header for the drill-down pages. The dashboard is the entry point, so
 * every sub-page states its position in the index and offers one obvious way
 * back.
 */
const { title, description, back = '回到总览', index = '', kicker = '档案' } = Astro.props;
---

<header class="page-head">
  <p class="kicker">
    {index && <span class="accent">{index}</span>}
    {index && <span aria-hidden="true">/</span>}
    {kicker}
  </p>
  <div class="page-head-row">
    <div>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <a class="text-link" href={href()}>
      <Icon name="arrow-left" size={13} /> {back}
    </a>
  </div>
</header>
