---
/**
 * 180-day availability strip built from the daily history rows. Pure markup:
 * one <i> per day, height proportional to online/monitored, tone by share.
 */
const { daily, days = 180 } = Astro.props;
const byDate = new Map(daily.map((entry) => [entry.date, entry]));
const today = new Date();
const cells = [];

for (let offset = days - 1; offset >= 0; offset -= 1) {
  const date = new Date(today.getTime() - offset * 86_400_000).toISOString().slice(0, 10);
  const entry = byDate.get(date);
  const ratio = entry && entry.monitored > 0 ? entry.online / entry.monitored : null;
  const share = ratio == null ? 'none' : ratio >= 0.95 ? 'high' : ratio >= 0.8 ? 'mid' : 'low';
  cells.push({
    date,
    share,
    height: ratio == null ? 8 : Math.max(8, Math.round(ratio * 100)),
    title: entry ? `${date}：${entry.online}/${entry.monitored} 在线` : `${date}：无数据`,
  });
}
---

<figure class="spark-wrap">
  <div class="spark" role="img" aria-label="最近 180 天在线率">
    {cells.map((cell) => (
      <i data-share={cell.share} style={`height:${cell.height}%`} title={cell.title} />
    ))}
  </div>
  <figcaption class="toolbar-meta">
    <span>
      {cells[0]?.date} → {cells.at(-1)?.date}
    </span>
    <span>绿色 ≥95% · 黄色 ≥80% · 红色 &lt;80% · 灰色无数据</span>
  </figcaption>
</figure>
