---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { loadSiteData } from '../../data/site.js';
import { href, asset } from '../../lib/paths.js';

/**
 * Case studies come from content/cases/*.md (frontmatter + body). The page is
 * generated only for projects that are actually featured, so a markdown file
 * without a matching ordered project is a build-time error rather than a
 * hidden orphan page.
 */
export async function getStaticPaths() {
  const { projects } = loadSiteData();
  const bySlug = new Map(projects.filter((p) => p.featured).map((p) => [p.name, p]));
  const files = import.meta.glob('../../../content/cases/*.md', { eager: true });

  return Object.entries(files).map(([file, mod]) => {
    const slug = file.split('/').pop().replace(/\.md$/, '');
    const project = bySlug.get(slug);
    if (!project) throw new Error(`content/cases/${slug}.md 没有对应的代表作（featured + order）`);
    return { params: { slug }, props: { project, Content: mod.Content, frontmatter: mod.frontmatter } };
  });
}

const { project, Content, frontmatter } = Astro.props;
const illustration = frontmatter.illustration ?? null;
const illustrationCaption =
  frontmatter.illustrationCaption ?? `${frontmatter.title ?? project.name} 当前界面`;
const title = frontmatter.title ?? project.featured.title;
---

<Base title={title} description={frontmatter.summary ?? project.description} active="home" breadcrumb={title}>
  <article class="article">
    <p class="eyebrow">项目笔记 / {project.categoryLabel}</p>
    <h1>{title}</h1>
    <p class="lede">{frontmatter.summary ?? project.description}</p>

    {(illustration || project.coverAvailable) && (
      <figure>
        <img
          src={illustration ? asset(illustration) : asset(project.cover)}
          alt={`${title} ${illustration ? '示意图' : '界面截图'}`}
          loading="lazy"
          width={illustration ? 400 : 1440}
          height={illustration ? 300 : 900}
        />
        <figcaption>{illustrationCaption}</figcaption>
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <div class="article-actions">
      {project.repo && (
        <a class="btn btn--primary" href={`${project.repo}#readme`} target="_blank" rel="noopener noreferrer">
          {project.featured.action} <Icon name="arrow-up-right" size={13} />
        </a>
      )}
      {project.monitorHomepage && (
        <a class="btn" href={project.homepage} target="_blank" rel="noopener noreferrer">
          打开在线版本 ↗
        </a>
      )}
      <a class="text-link" href={href('catalog/')}>
        ← 回到项目目录
      </a>
    </div>
  </article>
</Base>
