---
import Base from '../layouts/Base.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import Stats from '../components/Stats.astro';
import Icon from '../components/Icon.astro';
import { loadSiteData, site } from '../data/site.js';
import { href, asset } from '../lib/paths.js';

const { featured, projects, stats } = loadSiteData();
const home = site.home;
const catalogCount = projects.length;
---

<Base title={home.title.lead} description={site.description} active="home">
  <div class="container">
    <section class="hero">
      <div>
        <span class="kicker">{home.kicker}</span>
        <h1>
          {home.title.lead}
          <br />
          <em>{home.title.em}</em>
          {home.title.suffix}
        </h1>
        <p class="lede">
          {home.summary} / {home.summaryExtra}
        </p>
        <div class="cta">
          <a class="btn btn--primary" href={href('catalog/')}>
            {home.primaryAction} <Icon name="arrow-right" size={14} />
          </a>
          <a class="text-link" href="#selected">
            {home.secondaryAction} ↓
          </a>
        </div>
      </div>
      <figure class="hero-art">
        <img src={asset('assets/fold.svg')} alt="" width="520" height="390" decoding="async" />
        <figcaption>
          <span>ARCHIVE / {String(catalogCount).padStart(3, '0')}</span>
          <span>GRID 32</span>
        </figcaption>
      </figure>
    </section>

    <section class="section" id="selected">
      <div class="section-head">
        <div>
          <h2>Selected work</h2>
          <p>长期维护、有明确使用场景的项目。</p>
        </div>
        <a class="text-link" href={href('catalog/')}>
          全部项目 ({catalogCount}) <Icon name="arrow-up-right" size={13} />
        </a>
      </div>
      <div class="features">
        {featured.map((project) => (
          <FeaturedCard project={project} />
        ))}
      </div>
    </section>

    <section class="section" aria-label="档案统计">
      <Stats
        items={[
          { value: catalogCount, label: '收录项目' },
          { value: featured.length, label: '代表作品' },
          { value: stats.monitored, label: '监控网页' },
          { value: stats.forks, label: 'Fork（不访问）' },
        ]}
      />
      <aside class="archive-strip" aria-label="档案入口">
        <a href={href('catalog/')}>
          <strong>{catalogCount}</strong>
          <span>按分类浏览全部项目</span>
        </a>
        <a href={href('status/')}>
          <strong>{stats.online}</strong>
          <span>当前可访问</span>
        </a>
        <a href={href('history/')}>
          <strong>{stats.attention}</strong>
          <span>需要关注</span>
        </a>
      </aside>
    </section>
  </div>
</Base>
