---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths.js';
---

<Base title="页面不存在" description="这个地址没有对应的页面。" noindex>
  <div class="container">
    <div class="notfound">
      <p class="eyebrow">404</p>
      <h1>这里没有页面</h1>
      <p>链接可能已经随项目重构调整过。</p>
      <a class="btn btn--primary" href={href('catalog/')}>
        浏览项目目录
      </a>
    </div>
  </div>
</Base>
