---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths.js';
---

<Base title="页面不存在" description="这个地址没有对应的页面。" noindex>
  <div class="article" style="text-align:center;margin:var(--s8) auto">
    <span class="eyebrow">404</span>
    <h1>这里没有页面</h1>
    <p class="lede">链接可能已经随项目重构调整过。</p>
    <div class="article-actions" style="justify-content:center;border:0">
      <a class="btn btn--primary" href={href()}>
        回到工作台
      </a>
    </div>
  </div>
</Base>
