---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths.js';
---

<Base title="页面不存在" description="这个地址没有对应的页面。" noindex>
  <div class="not-found">
    <p class="code" aria-hidden="true">
      404
    </p>
    <p class="kicker">Page not found</p>
    <h1>这里没有页面</h1>
    <p class="lede">链接可能已经随项目重构调整过。</p>
    <div class="article-actions">
      <a class="btn btn--primary" href={href()}>
        回到总览
      </a>
      <a class="btn" href={href('catalog/')}>
        浏览全部项目
      </a>
    </div>
  </div>
</Base>
