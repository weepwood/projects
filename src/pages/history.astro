---
import Base from '../layouts/Base.astro';
import Sparkline from '../components/Sparkline.astro';
import { HEALTH_LABELS } from '../lib/health.js';
import { loadSiteData, site } from '../data/site.js';

const { history } = loadSiteData();
const daily = [...(history.daily ?? [])].reverse();
const events = [...(history.events ?? [])].reverse();
const fmt = (iso) =>
  iso ? new Date(iso).toLocaleString('zh-CN', { timeZone: 'Asia/Hong_Kong', hour12: false }) : '—';
const label = (status) => HEALTH_LABELS[status] ?? status;
---

<Base title={site.history.title} description={site.history.description} active="history">
  <div class="container">
    <header class="page-head">
      <h1>{site.history.title}</h1>
      <p class="lede">
        保留最近 180 天的每日汇总，以及最近 1000
        条状态变化事件。只在状态真正变化时记录，因此文件不会随检查次数线性增长。
      </p>
    </header>

    <section class="section" style="padding-top:0">
      <div class="section-head">
        <div>
          <h2>可用率</h2>
          <p>柱高为当日在线占比。</p>
        </div>
      </div>
      <Sparkline {daily} />
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <h2>每日汇总</h2>
          <p>每天一条记录。</p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">日期</th>
              <th scope="col" class="num">
                监控
              </th>
              <th scope="col" class="num">
                正常
              </th>
              <th scope="col" class="num">
                警告
              </th>
              <th scope="col" class="num">
                离线
              </th>
              <th scope="col" class="num">
                不监控
              </th>
            </tr>
          </thead>
          <tbody>
            {daily.length === 0 ? (
              <tr>
                <td colspan="6">暂无数据</td>
              </tr>
            ) : (
              daily.map((entry) => (
                <tr>
                  <td>{entry.date}</td>
                  <td class="num">{entry.monitored}</td>
                  <td class="num">{entry.online}</td>
                  <td class="num">{entry.warning}</td>
                  <td class="num">{entry.offline}</td>
                  <td class="num">{entry.notMonitored}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <h2>状态变化</h2>
          <p>仅记录状态切换。</p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">时间</th>
              <th scope="col">项目</th>
              <th scope="col">变化</th>
              <th scope="col">详情</th>
            </tr>
          </thead>
          <tbody>
            {events.length === 0 ? (
              <tr>
                <td colspan="4">尚无状态变化</td>
              </tr>
            ) : (
              events.map((event) => (
                <tr>
                  <td>{fmt(event.at)}</td>
                  <td>{event.fullName}</td>
                  <td>
                    {label(event.from)} → {label(event.to)}
                  </td>
                  <td>{event.error ?? event.statusCode ?? '—'}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>
