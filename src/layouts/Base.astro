---
import '../styles/index.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
import { href, asset } from '../lib/paths.js';

const {
  title,
  description = site.description,
  active = '',
  image = 'og.svg',
  noindex = false,
  counts = {},
} = Astro.props;

const pageTitle = active === 'home' ? `${site.title} · 项目索引` : `${title} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(href(image), site.url).href;

// A numbered table of contents. Every page states its position in the index,
// which is the one navigational idea the whole site relies on.
const nav = [
  { id: 'home', label: '总览', href: '', index: '01' },
  { id: 'catalog', label: '全部项目', href: 'catalog/', index: '02', count: counts.projects },
  { id: 'status', label: '在线状态', href: 'status/', index: '03' },
  { id: 'history', label: '历史记录', href: 'history/', index: '04' },
];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} · 新增项目`}
      href={href('feed.xml')}
    />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Applies the saved theme before first paint so there is no flash. The
      // default is the paper edition; dark is an explicit opt-in.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>

    <div class="app" id="app">
      <header class="masthead">
        <div class="masthead-inner">
          <a class="brand" href={href()}>
            <span class="brand-mark" aria-hidden="true">
              {site.brand.mark}
            </span>
            <span class="brand-text">
              <strong>{site.brand.name}</strong>
              <span>项目档案</span>
            </span>
          </a>

          <nav class="site-nav" id="site-nav" aria-label="主导航">
            {nav.map((item) => (
              <a
                class="nav-link"
                href={href(item.href)}
                aria-current={active === item.id ? 'page' : undefined}
              >
                <span class="nav-index">{item.index}</span>
                {item.label}
                {typeof item.count === 'number' && <span class="nav-count">{item.count}</span>}
              </a>
            ))}
          </nav>

          <div class="masthead-actions">
            <a class="mast-link" href={href('feed.xml')} title="新增项目 RSS">
              <Icon name="rss" size={13} />
              <span>RSS</span>
            </a>
            <button
              class="icon-btn"
              type="button"
              id="theme-toggle"
              aria-label="切换主题"
              aria-pressed="false"
            >
              <Icon name="sun-moon" size={15} />
            </button>
            <button
              class="nav-toggle"
              type="button"
              id="nav-toggle"
              aria-expanded="false"
              aria-controls="site-nav"
            >
              <Icon name="menu" size={15} />
              <span>目录</span>
            </button>
          </div>
        </div>
      </header>

      <main class="main" id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <span>{site.footer}</span>
          <span>
            <a href={href('feed.xml')}>RSS</a>
            <span aria-hidden="true"> / </span>
            <a href="https://github.com/weepwood/projects" target="_blank" rel="noopener noreferrer">
              源码
            </a>
          </span>
        </div>
      </footer>
    </div>

    <script>
      import '../client/shell.js';
    </script>
  </body>
</html>
