---
import '../styles/index.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
import { href, asset } from '../lib/paths.js';

const {
  title,
  description = site.description,
  active = '',
  image = '/og.svg',
  noindex = false,
  breadcrumb = null,
  counts = {},
} = Astro.props;

const pageTitle = active === 'home' ? `${site.title} · 项目索引` : `${title} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

// Navigation is grouped so every entry point states what it is. The dashboard is
// the one place that shows everything; the other pages are drill-downs from it.
const groups = [
  {
    label: '工作台',
    items: [{ id: 'home', label: '总览', icon: 'panels-top-left', href: '', count: null }],
  },
  {
    label: '档案',
    items: [
      { id: 'catalog', label: '全部项目', icon: 'library', href: 'catalog/', count: counts.projects },
      { id: 'status', label: '在线状态', icon: 'activity', href: 'status/', count: null },
      { id: 'history', label: '历史记录', icon: 'history', href: 'history/', count: null },
    ],
  },
];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} · 新增项目`}
      href={href('feed.xml')}
    />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Applies the saved theme before first paint so there is no flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>

    <div class="app" id="app">
      <aside class="sidebar" id="sidebar">
        <a class="brand" href={href()}>
          <span class="brand-mark" aria-hidden="true">
            {site.brand.mark}
          </span>
          <span class="brand-text">
            <strong>{site.brand.name}</strong>
            <span>项目档案</span>
          </span>
        </a>

        <nav aria-label="主导航">
          {groups.map((group) => (
            <div class="nav-group">
              <p class="nav-label">{group.label}</p>
              {group.items.map((item) => (
                <a
                  class="nav-item"
                  href={href(item.href)}
                  aria-current={active === item.id ? 'page' : undefined}
                >
                  <Icon name={item.icon} size={15} />
                  {item.label}
                  {typeof item.count === 'number' ? <span class="nav-count">{item.count}</span> : null}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="sidebar-facts">
          <h2>档案事实</h2>
          <div class="fact-row">
            <span>收录项目</span>
            <strong>{counts.projects ?? '—'}</strong>
          </div>
          <div class="fact-row">
            <span>监控网页</span>
            <strong>{counts.monitored ?? '—'}</strong>
          </div>
          <div class="fact-row">
            <span>当前正常</span>
            <strong class={counts.attention ? 'is-warn' : undefined}>{counts.online ?? '—'}</strong>
          </div>
          <div class="fact-row">
            <span>需关注</span>
            <strong class={counts.attention ? 'is-warn' : undefined}>{counts.attention ?? 0}</strong>
          </div>
        </div>
      </aside>

      <div class="workspace">
        <header class="topbar">
          <button
            class="sidebar-toggle"
            type="button"
            id="sidebar-toggle"
            aria-label="打开导航"
            aria-expanded="false"
            aria-controls="sidebar"
          >
            <Icon name="panels-top-left" size={16} />
          </button>

          <div class="crumbs">
            <a href={href()}>总览</a>
            {breadcrumb && (
              <>
                <span aria-hidden="true">/</span>
                <b>{breadcrumb}</b>
              </>
            )}
          </div>

          <div class="topbar-actions">
            <a class="btn btn--sm" href={href('feed.xml')} title="新增项目 RSS">
              <Icon name="rss" size={13} /> RSS
            </a>
            <button
              class="btn btn--icon"
              type="button"
              id="theme-toggle"
              aria-label="切换主题"
              aria-pressed="false"
            >
              <Icon name="sun-moon" size={15} />
            </button>
          </div>
        </header>

        <main class="main" id="main">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../client/shell.js';
    </script>
  </body>
</html>
