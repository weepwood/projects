{
  "name": "weepwood-projects",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "enrich": "node src/cli/enrich.js",
    "health": "node src/cli/health.js",
    "issues:sync": "node src/cli/issues.js",
    "screenshots:plan": "node src/cli/screenshots.js --plan",
    "screenshots:capture": "node src/cli/screenshots.js",
    "pipeline": "node src/cli/pipeline.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:budget": "node src/cli/budget.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run check:budget"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@eslint/js": "^9.39.5",
    "astro": "^5.18.2",
    "eslint": "^9.39.0",
    "globals": "^17.14.0",
    "playwright": "^1.54.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
